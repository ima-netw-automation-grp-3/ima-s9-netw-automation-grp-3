# Réglages du lab, lus automatiquement par docker compose depuis le fichier .env.
#
# make init crée .env à partir de ce fichier et remplit les secrets laissés vides ci-dessous
# (mots de passe, jetons) avec des valeurs aléatoires. Sans make : cp .env.example .env, puis
# remplissez chaque variable marquée « obligatoire » : docker compose refuse de démarrer sans elles.

# Adresse et port de publication de l'interface web.
# 127.0.0.1 par défaut : l'interface a accès à la socket Docker (équivalent root sur l'hôte).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Noms d'hôte acceptés dans l'en-tête Host (protection contre le DNS rebinding), séparés par des virgules,
# en plus de localhost, 127.0.0.1 et [::1], toujours acceptés (healthcheck, make smoke). Si vous publiez
# l'interface sur le réseau (WEB_BIND=0.0.0.0), ajoutez le nom ou l'IP utilisés dans le navigateur,
# ex. : labserver,192.168.10.5
WEB_ALLOWED_HOSTS=

# Authentification HTTP Basic (activée si les deux valeurs sont renseignées). Obligatoire dès que
# l'interface est exposée (WEB_BIND autre que l'adresse de boucle locale, ou nom non local dans
# WEB_ALLOWED_HOSTS) : elle refuse sinon de démarrer.
WEB_AUTH_USER=
WEB_AUTH_PASSWORD=

# --- Métrologie (Telegraf, InfluxDB, Grafana) ------------------------------------------------
# Grafana : tableaux de bord, consultables sans compte (lecture seule). Le compte admin sert à
# les modifier.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# obligatoire (premier démarrage seulement, volume vide ; ensuite : grafana cli admin reset-admin-password)
GRAFANA_ADMIN_PASSWORD=
# URL de Grafana vue par le navigateur, pour l'onglet « Métrologie » de l'interface.
# Vide = même hôte que l'interface, port GRAFANA_PORT. À renseigner derrière un reverse proxy.
GRAFANA_URL=

# Captures de paquets (onglet « Capture » des nœuds) : image Wireshark (LinuxServer), nombre de captures
# simultanées et taille maximale d'un pcap (la sonde s'arrête ensuite).
CAPTURE_IMAGE=lscr.io/linuxserver/wireshark:4.6.9
CAPTURE_MAX_SESSIONS=3
CAPTURE_MAX_MB=500

# InfluxDB : base de séries temporelles (organisation sonic-lab, bucket lab).
# ATTENTION : les variables INFLUXDB_ADMIN_*, INFLUXDB_TOKEN et INFLUXDB_RETENTION ne servent qu'au
# premier démarrage (volume vide). Pour les changer ensuite : make down, puis
# docker volume rm sonic-lab_influxdb-data sonic-lab_influxdb-config (données perdues), puis make up.
INFLUXDB_BIND=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_ADMIN_USER=admin
# obligatoire, 8 caractères minimum
INFLUXDB_ADMIN_PASSWORD=
# obligatoire : jeton d'API, utilisé par Telegraf et Grafana
INFLUXDB_TOKEN=
# durée de conservation des mesures (ex. 7d, 30d, 52w) ; compter environ 0,5 Go par jour pour le lab
# de base au rythme de 10 s (moins une fois les fichiers compactés par InfluxDB)
INFLUXDB_RETENTION=7d

# Telegraf : intervalle de collecte et sondes ping entre les nœuds.
TELEGRAF_INTERVAL=10s
# all : toutes les adresses du lab des autres nœuds ; primary : Loopback0 des routeurs et première
# adresse des clients ; off : pas de sondes
PROBE_SCOPE=all
PROBE_COUNT=5
PROBE_INTERVAL=0.2
PROBE_MAX_TARGETS=64

# Flux sFlow des routeurs (tableau « Flux réseau ») : Telegraf reçoit les datagrammes de hsflowd sur le
# réseau de management, à cette IP fixe, port UDP SFLOW_PORT (0 = pas de collecte de flux). Choisir une
# IP libre du sous-réseau : ni .1, ni GITLAB_IP, ni celles des nœuds. La conf sFlow des routeurs
# (collecteur, taux d'échantillonnage) est déployée par la CD Ansible du projet network-config, dont les
# jobs reçoivent FLOW_COLLECTOR_IP. Après un changement : make up.
FLOW_COLLECTOR_IP=172.20.30.6
SFLOW_PORT=6343
# nombre maximal de séries de flux écrites par cycle de collecte
FLOW_MAX_KEYS=2000

# --- GitLab ----------------------------------------------------------------------------------
# GitLab de l'équipe, sur le réseau de management du lab (172.20.30.0/24) : http://<GITLAB_IP>, et
# git en SSH sur le port 22 de cette IP. Joignable depuis l'hôte et depuis les nœuds du lab.
# Choisir une IP libre du sous-réseau : ni .1 (passerelle), ni FLOW_COLLECTOR_IP (.6), ni celles des
# nœuds (.11, .12, .21, .22).
GITLAB_IP=172.20.30.5
# obligatoire : mot de passe du compte root (administrateur), au premier démarrage seulement (volume
# vide). 8 caractères minimum, sans « root », « admin » ni « gitlab ».
GITLAB_ROOT_PASSWORD=
# Groupe dont les comptes ci-dessous sont Owner.
GITLAB_GROUP=ima-netw-automation-grp-3
# Comptes « utilisateur:motdepasse », séparés par des virgules, créés s'ils n'existent pas (vide : root
# seulement ; make init crée le compte « lab »). 8 caractères minimum : GitLab refuse les mots de passe
# plus courts, même à la connexion. Le mot de passe d'ici s'applique tant que le compte ne s'est jamais
# connecté à l'interface.
GITLAB_USERS=
# obligatoire : jeton d'API de root, utilisé par gitlab-sync, le runner, l'agent GitOps et l'interface
# (et utilisable pour vos scripts) : exactement 20 caractères.
GITLAB_API_TOKEN=
# Intervalle (secondes) de synchronisation des dépôts avec gitlab/repos/ (versionné avec le projet).
GITLAB_SYNC_INTERVAL=60
# GitLab derrière un reverse proxy HTTPS (Caddy…) : son URL publique. Le TLS s'arrête au proxy, GitLab
# reste en HTTP sur le port 80 et fait confiance à l'hôte (passerelle du réseau de management).
# GITLAB_EXTERNAL_URL=https://gitlab.lab.example.com
# SSH de GitLab publié sur l'hôte : 127.0.0.1:2222 par défaut (le port 22 de l'hôte reste à son sshd).
# Sur un serveur dont le sshd écoute sur un autre port, publier git en SSH sur le port 22 :
# GITLAB_SSH_BIND=0.0.0.0
# GITLAB_SSH_PORT=22

# --- RESTCONF des routeurs et CI/CD (GitLab Runner) ---------------------------------------------
# Identifiants HTTP Basic du serveur RESTCONF de chaque routeur (https://172.20.30.11/restconf, .12),
# aussi fournis aux jobs CI. Après un changement : make up (qui recrée le service clab, donc redéploie le
# lab, et le runner).
RESTCONF_USER=admin
# obligatoire
RESTCONF_PASSWORD=
# Runner GitLab (enregistré automatiquement comme runner d'instance « sonic-lab ») : jobs en parallèle,
# tags du runner (il accepte aussi les jobs sans tag), image par défaut des jobs.
GITLAB_RUNNER_CONCURRENT=2
GITLAB_RUNNER_TAGS=sonic-lab,restconf
GITLAB_RUNNER_IMAGE=python:3.12-alpine

# --- Infra en GitOps (topologie + confs de démarrage dans GitLab) -------------------------------
# Projet GitLab de l'infra, créé par make infra-project (vide = <GITLAB_GROUP>/lab-infra). Tant qu'il
# n'existe pas, l'agent ne fait rien et l'interface sauvegarde dans lab/configs/ comme avant.
GITOPS_PROJECT=
# 0 : agent GitOps désactivé (service clab).
GITOPS_ENABLED=1
# Intervalle (secondes) de scrutation de GitLab par l'agent.
GITOPS_INTERVAL=20
# Images autorisées dans la topologie (les nœuds sont des conteneurs privilégiés).
GITOPS_ALLOWED_IMAGES=docker-sonic-vs:latest,alpine:3.22

# --- Image SONiC --------------------------------------------------------------------------------
# Empreinte attendue de docker-sonic-vs.gz, vérifiée avant le chargement de l'image (voir GUIDE.md,
# « Image SONiC »). Décommentez avec une valeur vide pour ne rien vérifier, ou mettez celle d'une
# autre build.
# SONIC_ARCHIVE_SHA256=
