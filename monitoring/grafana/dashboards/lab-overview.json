    {
      "type": "timeseries",
      "title": "Débit par lien",
      "description": "Sens A→Z au-dessus de l'axe, Z→A en dessous.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-lab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-lab"
          },
          "query": "SELECT mean(\"a_to_z_bps\") AS \"A→Z\", mean(\"z_to_a_bps\") AS \"Z→A\" FROM \"lab_link\" WHERE $timeFilter GROUP BY time($__interval), \"link\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_link $col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "aucune donnée sur la période"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* Z→A"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
