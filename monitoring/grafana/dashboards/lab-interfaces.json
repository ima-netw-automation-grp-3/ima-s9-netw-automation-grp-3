    {
      "type": "timeseries",
      "title": "Débit",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-lab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-lab"
          },
          "query": "SELECT mean(\"rx_bps\") AS \"rx\", mean(\"tx_bps\") AS \"tx\" FROM \"lab_interface\" WHERE \"node\" =~ /^$node$/ AND \"if_type\" =~ /^$if_type$/ AND \"linked\" =~ /^$linked$/ AND \"interface\" =~ /^$interface$/ AND $timeFilter GROUP BY time($__interval), \"interface\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_interface $col"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
