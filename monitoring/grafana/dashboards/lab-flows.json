    {
      "type": "timeseries",
      "title": "Débit par application",
      "description": "Liste « Trafic » : « Entrée du réseau » garde ce que les routeurs reçoivent sur leurs ports reliés à un client (trafic qui entre dans le réseau, compté une seule fois même s'il traverse plusieurs routeurs) ; un routeur sans port vers un client (spine, IPN) n'y voit rien. « Tous les ports » garde tout ce que reçoivent les routeurs choisis : un flux qui traverse plusieurs routeurs y est compté sur chacun. Estimation à partir des échantillons sFlow : chaque paquet échantillonné compte pour 256 paquets (taux d'échantillonnage des routeurs, minimum du modèle YANG de SONiC).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-lab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-lab"
          },
          "query": "SELECT sum(\"bytes\") * 8000 / $__interval_ms FROM \"lab_flow\" WHERE \"edge\" != '$vue' AND \"node\" =~ /^$node$/ AND (\"src_node\" =~ /^$client$/ OR \"dst_node\" =~ /^$client$/) AND $timeFilter GROUP BY time($__interval), \"app\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_app"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "aucun flux sur la période (routeur sans port vers un client ? liste « Trafic » › Tous les ports)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
